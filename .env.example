# ─────────────────────────────────────────────────────────────
# Ujyalo Learn — environment template (copy to .env.local)
# NEVER commit real secrets. Only VITE_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# ── Public site ───────────────────────────────────────────────
# Your final production URL (used for canonical links + sitemap).
VITE_SITE_URL=https://your-project.vercel.app

# Public contact address shown on the Contact page (optional).
# Leave empty to show "contact address not configured" instead of inventing one.
VITE_CONTACT_EMAIL=

# ── Firebase web app (public keys — safe to ship) ─────────────
# Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── AI provider (SERVER-ONLY — no VITE_ prefix!) ──────────────
# OpenAI-compatible chat-completions providers only.
# OpenAI:      https://api.openai.com/v1                    (gpt-4o-mini)
# Groq:        https://api.groq.com/openai/v1               (openai/gpt-oss-120b)
# OpenRouter:  https://openrouter.ai/api/v1                 (openai/gpt-4o-mini)
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai (gemini-2.0-flash)
# Mistral:     https://api.mistral.ai/v1                    (mistral-small-latest)
AI_PROVIDER_NAME=openai-compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=45000
# Reasoning models (gpt-oss, o-series) spend part of this budget on hidden
# reasoning tokens, so keep it generous — 4000 works well for gpt-oss-120b.
AI_MAX_OUTPUT_TOKENS=4000
AI_TEMPERATURE=0.4

# Comma-separated allowlist of provider hosts (SSRF protection).
AI_ALLOWED_HOSTS=api.openai.com,api.groq.com,openrouter.ai,generativelanguage.googleapis.com,api.mistral.ai,api.together.xyz,api.deepseek.com

# ── Usage protection ─────────────────────────────────────────
# Best-effort per-instance limits (see README for global limits).
AI_RATE_LIMIT_PER_MINUTE=12
AI_MAX_REQUESTS_PER_DAY=120
AI_REQUIRE_AUTH=false
AI_MAX_BODY_KB=32

# ── Server-side Firebase token verification (optional) ───────
# Same values as the web config; used by /api to verify user ID tokens.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# ── Admin / operations ───────────────────────────────────────
# Comma-separated Firebase UIDs with owner access (server-side only).
ADMIN_UIDS=

# ── Ujyalo Connect: Discord OAuth2 (server-side only) ────────
# See docs/UJYALO-CONNECT.md §2. Leave empty to keep Discord sign-in switched
# off: /connect will say so plainly rather than simulating accounts.
# NEVER prefix the secret with VITE_ — that would ship it to every browser.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the Redirect added in the Discord developer portal, exactly.
DISCORD_REDIRECT_URI=https://ujyalo-learn.vercel.app/api/connect/callback
# 32+ random characters. Encrypts the OAuth state cookie (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECT_SESSION_SECRET=

# Local testing only — ignored when NODE_ENV or VERCEL_ENV is production.
# DISCORD_AUTHORIZE_URL=http://127.0.0.1:9097/oauth2/authorize
# DISCORD_TOKEN_URL=http://127.0.0.1:9097/api/oauth2/token
# DISCORD_USER_URL=http://127.0.0.1:9097/api/users/@me
