rules_version = '2';

// Ujyalo Learn — Firestore security rules
//
// Principles:
//  - Every record is owned by exactly one authenticated user.
//  - Reads and writes are allowed only for the owner (request.auth.uid).
//  - Documents in subcollections must carry ownerId == the owner on create,
//    and cannot change owner on update.
//  - Nothing is readable by administrators through the client SDK.
//  - Anything not explicitly allowed is denied.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownerMatches(uid) {
      return request.resource.data.ownerId == uid;
    }

    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function textWithin(field, maxLength) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLength;
    }

    // ── Student profile ────────────────────────────────────────────────
    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.preferences is map
        && request.resource.data.preferences.subjects.size() <= 12
        && request.resource.data.preferences.goals.size() <= 12
        && request.resource.data.onboardingComplete is bool;

      // ── Conversations + messages ─────────────────────────────────────
      match /conversations/{conversationId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.messageCount is int
          && request.resource.data.messageCount >= 0;

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200);

        match /messages/{messageId} {
          allow read, delete: if isOwner(uid);

          allow create: if isOwner(uid)
            && ownerMatches(uid)
            && request.resource.data.conversationId == conversationId
            && request.resource.data.role in ['user', 'assistant']
            && textWithin('content', 20000);

          allow update: if isOwner(uid)
            && ownerUnchanged()
            && request.resource.data.conversationId == conversationId
            && textWithin('content', 20000);
        }
      }

      // ── Notes ────────────────────────────────────────────────────────
      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && textWithin('content', 20000)
          && request.resource.data.source in ['ai', 'student'];

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && textWithin('content', 20000)
          && request.resource.data.source in ['ai', 'student'];
      }

      // ── Quizzes ──────────────────────────────────────────────────────
      match /quizzes/{quizId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 20
          && request.resource.data.source == 'ai';

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 20;
      }

      // ── Quiz attempts ────────────────────────────────────────────────
      match /attempts/{attemptId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.total <= 20
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.total
          && textWithin('quizTitle', 200);

        allow update: if isOwner(uid) && ownerUnchanged();
      }

      // ── Flashcard decks ──────────────────────────────────────────────
      match /decks/{deckId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 40;

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 40;
      }

      // ── Goals and tasks ──────────────────────────────────────────────
      match /goals/{goalId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200);

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200);
      }

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 600
          && request.resource.data.completed is bool;

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 600
          && request.resource.data.completed is bool;
      }

      // ── Activity log ─────────────────────────────────────────────────
      match /activity/{eventId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.type in ['tutor', 'quiz', 'note', 'flashcard', 'task', 'goal']
          && textWithin('label', 200);

        allow update: if false;
      }
    }


    // ══════════════════════════════════════════════════════════════════
    //  Learning library (courses, resources, settings, audit, roles)
    //
    //  These documents are shared, not student-owned. Reads of published
    //  content are public; every write requires a role document that says
    //  owner/admin/editor. Roles are read through `get()` so the check is
    //  made by the database, never by the browser.
    // ══════════════════════════════════════════════════════════════════

    function role() {
      return signedIn() ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role : 'guest';
    }

    function isEditor() {
      return signedIn() && role() in ['owner', 'admin', 'editor'];
    }

    function isAdmin() {
      return signedIn() && role() in ['owner', 'admin'];
    }

    function isSiteOwner() {
      return signedIn() && role() == 'owner';
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function validSlug() {
      return request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 60;
    }

    function validCourse() {
      return validSlug()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 240
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.gradeMin is int
        && request.resource.data.gradeMax is int
        && request.resource.data.gradeMin >= 1
        && request.resource.data.gradeMax <= 12
        && request.resource.data.lessons is list
        && request.resource.data.lessons.size() <= 40;
    }

    function validResource() {
      return validSlug()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 200
        && request.resource.data.license is string
        && request.resource.data.license.size() > 0
        && request.resource.data.license.size() <= 200
        && request.resource.data.body is list
        && request.resource.data.body.size() <= 60;
    }

    match /courses/{courseId} {
      // Anyone may read a published course. Drafts need a role.
      allow read: if isPublished() || isEditor();

      allow create, update: if isEditor() && validCourse();
      allow delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isPublished() || isEditor();

      // Attribution and licence are mandatory: no anonymous material.
      allow create, update: if isEditor() && validResource();
      allow delete: if isAdmin();
    }

    match /seoPages/{pathKey} {
      // Public metadata overrides. Read is open because the values are already
      // visible in the page; writes are admin-only and length/type constrained.
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 320
        && request.resource.data.noindex is bool;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles/{uid} {
      // A signed-in user may read only their own role document.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isSiteOwner();
      allow write: if isSiteOwner();
    }

    match /auditLogs/{eventId} {
      allow read: if isAdmin();
      // Editors may append. Nobody may edit or delete through the client.
      allow create: if isEditor()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Global Quiz Arena
    //
    // Every Arena document is written by the API using Admin credentials, which
    // bypass these rules entirely. No browser may read or write any of them:
    // not the question bank, not the answer key, not scores, not ranks.
    //
    // That is the point of this feature. Points are only trustworthy if the
    // student's browser has no write path to them at all.
    // ---------------------------------------------------------------------
    match /arenaPlayers/{uid} {
      allow read, write: if false;
    }
    match /arenaHandles/{handle} {
      allow read, write: if false;
    }
    match /arenaAttempts/{attemptId} {
      allow read, write: if false;
    }
    match /arenaPoints/{entryId} {
      allow read, write: if false;
    }
    match /arenaDaily/{dayKey} {
      allow read, write: if false;
    }
    match /arenaBadges/{badgeId} {
      allow read, write: if false;
    }
    match /arenaRate/{uid} {
      allow read, write: if false;
    }


    // ---------------------------------------------------------------------
    // Ujyalo Connect — communities
    //
    // A different shape from the rest of Ujyalo Learn, on purpose. Student
    // records are private to their owner; a community is shared by design, so
    // the rule is "members may read what the community contains", not "only
    // the author may read it".
    //
    // The identity mapping is the exception and is never client-readable:
    // knowing another person's Discord id should not be possible from here.
    // ---------------------------------------------------------------------

    function connectSignedIn() {
      return request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    function isCommunityMember(communityId) {
      return connectSignedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    // Discord ids are numeric strings; the uid derived from one is the only
    // shape a Connect profile may have.
    match /connectIdentities/{discordId} {
      allow read, write: if false;
    }

    match /connectProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // The server writes this on sign-in with Admin credentials. A client may
      // edit only the fields a person is allowed to choose for themselves.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.discordId == resource.data.discordId
        && request.resource.data.discordUsername == resource.data.discordUsername
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberships == resource.data.memberships
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 400;
      allow create, delete: if false;
    }

    // Community metadata is public so the hub can be browsed before signing
    // in — the same rule the rest of the site follows.
    match /communities/{communityId} {
      allow read: if true;

      allow create: if connectSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9][a-z0-9-]{2,39}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400
        && request.resource.data.memberCount == 0
        && request.resource.data.createdAt is string;

      // Only the owner may edit, and the owner cannot be reassigned.
      allow update: if connectSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == resource.data.slug;
      allow delete: if false;

      // Who is in a community is not public: a membership list would let any
      // visitor enumerate people by their Discord id. You may read your own
      // membership, and members may see who else is in the room. Everyone else
      // gets nothing.
      match /members/{uid} {
        allow read: if connectSignedIn()
          && (request.auth.uid == uid || isCommunityMember(communityId));
        // Writes go through POST /api/connect/join and /leave, which keep the
        // member record, the community counter and the profile's list in one
        // transaction. A browser cannot do that, so it cannot do this either.
        allow write: if false;
      }

      match /channels/{channelId} {
        // The channel list is public; the messages inside are not.
        allow read: if true;
        allow create, update, delete: if connectSignedIn()
          && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid;

        match /messages/{messageId} {
          allow read: if isCommunityMember(communityId);
          allow create: if isCommunityMember(communityId)
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 2000
            && request.resource.data.createdAt is string;
          // Messages are immutable once written. Editing history silently is
          // worse than having no edit button.
          allow update: if false;
          allow delete: if connectSignedIn()
            && (resource.data.authorUid == request.auth.uid
                || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid);
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
