rules_version = '2';

// Ujyalo Learn — Firestore security rules
//
// Principles:
//  - Every record is owned by exactly one authenticated user.
//  - Reads and writes are allowed only for the owner (request.auth.uid).
//  - Documents in subcollections must carry ownerId == the owner on create,
//    and cannot change owner on update.
//  - Nothing is readable by administrators through the client SDK.
//  - Anything not explicitly allowed is denied.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownerMatches(uid) {
      return request.resource.data.ownerId == uid;
    }

    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function textWithin(field, maxLength) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLength;
    }

    // ── Student profile ────────────────────────────────────────────────
    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.preferences is map
        && request.resource.data.preferences.subjects.size() <= 12
        && request.resource.data.preferences.goals.size() <= 12
        && request.resource.data.onboardingComplete is bool;

      // ── Conversations + messages ─────────────────────────────────────
      match /conversations/{conversationId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.messageCount is int
          && request.resource.data.messageCount >= 0;

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200);

        match /messages/{messageId} {
          allow read, delete: if isOwner(uid);

          allow create: if isOwner(uid)
            && ownerMatches(uid)
            && request.resource.data.conversationId == conversationId
            && request.resource.data.role in ['user', 'assistant']
            && textWithin('content', 20000);

          allow update: if isOwner(uid)
            && ownerUnchanged()
            && request.resource.data.conversationId == conversationId
            && textWithin('content', 20000);
        }
      }

      // ── Notes ────────────────────────────────────────────────────────
      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && textWithin('content', 20000)
          && request.resource.data.source in ['ai', 'student'];

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && textWithin('content', 20000)
          && request.resource.data.source in ['ai', 'student'];
      }

      // ── Quizzes ──────────────────────────────────────────────────────
      match /quizzes/{quizId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 20
          && request.resource.data.source == 'ai';

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 20;
      }

      // ── Quiz attempts ────────────────────────────────────────────────
      match /attempts/{attemptId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.total <= 20
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.total
          && textWithin('quizTitle', 200);

        allow update: if isOwner(uid) && ownerUnchanged();
      }

      // ── Flashcard decks ──────────────────────────────────────────────
      match /decks/{deckId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 40;

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 40;
      }

      // ── Goals and tasks ──────────────────────────────────────────────
      match /goals/{goalId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200);

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200);
      }

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && textWithin('title', 200)
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 600
          && request.resource.data.completed is bool;

        allow update: if isOwner(uid)
          && ownerUnchanged()
          && textWithin('title', 200)
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 600
          && request.resource.data.completed is bool;
      }

      // ── Activity log ─────────────────────────────────────────────────
      match /activity/{eventId} {
        allow read, delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && ownerMatches(uid)
          && request.resource.data.type in ['tutor', 'quiz', 'note', 'flashcard', 'task', 'goal']
          && textWithin('label', 200);

        allow update: if false;
      }
    }


    // ══════════════════════════════════════════════════════════════════
    //  Learning library (courses, resources, settings, audit, roles)
    //
    //  These documents are shared, not student-owned. Reads of published
    //  content are public; every write requires a role document that says
    //  owner/admin/editor. Roles are read through `get()` so the check is
    //  made by the database, never by the browser.
    // ══════════════════════════════════════════════════════════════════

    function role() {
      return signedIn() ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role : 'guest';
    }

    function isEditor() {
      return signedIn() && role() in ['owner', 'admin', 'editor'];
    }

    function isAdmin() {
      return signedIn() && role() in ['owner', 'admin'];
    }

    function isSiteOwner() {
      return signedIn() && role() == 'owner';
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function validSlug() {
      return request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 60;
    }

    function validCourse() {
      return validSlug()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 240
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.gradeMin is int
        && request.resource.data.gradeMax is int
        && request.resource.data.gradeMin >= 1
        && request.resource.data.gradeMax <= 12
        && request.resource.data.lessons is list
        && request.resource.data.lessons.size() <= 40;
    }

    function validResource() {
      return validSlug()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 200
        && request.resource.data.license is string
        && request.resource.data.license.size() > 0
        && request.resource.data.license.size() <= 200
        && request.resource.data.body is list
        && request.resource.data.body.size() <= 60;
    }

    match /courses/{courseId} {
      // Anyone may read a published course. Drafts need a role.
      allow read: if isPublished() || isEditor();

      allow create, update: if isEditor() && validCourse();
      allow delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isPublished() || isEditor();

      // Attribution and licence are mandatory: no anonymous material.
      allow create, update: if isEditor() && validResource();
      allow delete: if isAdmin();
    }

    match /seoPages/{pathKey} {
      // Public metadata overrides. Read is open because the values are already
      // visible in the page; writes are admin-only and length/type constrained.
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 320
        && request.resource.data.noindex is bool;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles/{uid} {
      // A signed-in user may read only their own role document.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isSiteOwner();
      allow write: if isSiteOwner();
    }

    match /auditLogs/{eventId} {
      allow read: if isAdmin();
      // Editors may append. Nobody may edit or delete through the client.
      allow create: if isEditor()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
